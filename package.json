{
  "name": "salerno43-digital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Digital play aid for Salerno '43 (GMT Games) with an AI opponent. Requires your own copy of the game.",
  "scripts": {
    "dev": "vite",
    "phone": "tsc --noEmit && vite build && vite preview --host --port 4173",
    "phone:dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "selfplay": "vite-node scripts/selfplay.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@astryxdesign/core": "^0.7.4",
    "@astryxdesign/theme-neutral": "^0.7.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vite-node": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
