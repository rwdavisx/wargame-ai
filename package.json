{
  "name": "salerno43-digital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Digital play aid for Salerno '43 (GMT Games) with an AI opponent. Requires your own copy of the game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
